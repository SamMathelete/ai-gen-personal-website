# --- Auth (writing section) -------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXTAUTH_SECRET=
AUTHORIZED_EMAIL=sambit.mishra.2003@gmail.com
NEXT_PUBLIC_AUTHORIZED_EMAIL=sambit.mishra.2003@gmail.com

# --- SEO --------------------------------------------------------------------
# Canonical origin, no trailing slash. Every canonical URL, Open Graph URL,
# robots.txt and sitemap entry is built from this, so preview deployments should
# set it to their own origin. Defaults to https://www.sambitmishra.in.
NEXT_PUBLIC_SITE_URL=https://www.sambitmishra.in

# --- Visitor metrics (/stats) -----------------------------------------------
# Upstash Redis, REST credentials (console.upstash.com → your database → REST API).
# Without both values the counter falls back to an in-memory store that resets on
# every restart, which is fine for local development but not for production.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Extra salt for the daily visitor hash. Any long random string; changing it
# resets today's distinct-visitor estimate and nothing else.
METRICS_SALT=

# Set to "true" to stop the browser sending page views altogether.
NEXT_PUBLIC_METRICS_DISABLED=
